{
  "name": "ecommerce-football-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Website đặt sân bóng đá mini 5/7 người tại TP.HCM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prototype": "node scripts/prototype-server.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-seed.js",
    "test": "node scripts/test.js",
    "e2e": "node e2e/run.mjs",
    "e2e:all": "node e2e/run-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0"
  },
  "overrides": {
    "mysql2": "$mysql2"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
