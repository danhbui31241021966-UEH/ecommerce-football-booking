PORT=3000
NODE_ENV=development
# Luôn nghe ở 127.0.0.1 (mặc định). NODE_ENV=production từ chối HOST khác localhost: ra mạng chỉ qua tunnel.
# HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fb_app
DB_PASSWORD=change_me
DB_NAME=football_booking

# Chuỗi ngẫu nhiên dài, KHÔNG commit giá trị thật
SESSION_SECRET=change_me_to_a_long_random_string

# Luật nghiệp vụ (giữ chỗ 15 phút, đặt trước 3 ngày, ...) là hằng số trong src/rules.js, không đặt ở đây.
# `npm test` tự tạo và xóa CSDL football_booking_test_<ngẫu nhiên>: DB_USER cần quyền ALL trên các CSDL tên đó.

# Khóa API của webhook SePay (R17): SePay gửi `Authorization: Apikey <khóa>`. KHÔNG commit giá trị thật; không đặt thì webhook từ chối mọi yêu cầu.
SEPAY_API_KEY=change_me_sepay_api_key

# Production sau tunnel (NODE_ENV=production): server từ chối khởi động nếu SESSION_SECRET/SEPAY_API_KEY/DB_PASSWORD/PROXY_SECRET còn `change_me…`,
# hoặc SESSION_SECRET/PROXY_SECRET ngắn hơn 32 ký tự (tạo bằng `openssl rand -hex 32`).
# Bí mật chung với Pages Function: mọi request phải mang header `X-SN-Proxy-Secret: <giá trị này>`, không thì 404. KHÔNG commit giá trị thật.
PROXY_SECRET=change_me_proxy_secret
