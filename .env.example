PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fb_app
DB_PASSWORD=change_me
DB_NAME=football_booking

# Chuỗi ngẫu nhiên dài, KHÔNG commit giá trị thật
SESSION_SECRET=change_me_to_a_long_random_string

# Luật nghiệp vụ (giữ chỗ 15 phút, đặt trước 3 ngày, ...) là hằng số trong src/rules.js, không đặt ở đây.
# `npm test` tự tạo và xóa CSDL football_booking_test_<ngẫu nhiên>: DB_USER cần quyền ALL trên các CSDL tên đó.

# Khóa API của webhook SePay (R17): SePay gửi `Authorization: Apikey <khóa>`. KHÔNG commit giá trị thật; không đặt thì webhook từ chối mọi yêu cầu.
SEPAY_API_KEY=change_me_sepay_api_key
